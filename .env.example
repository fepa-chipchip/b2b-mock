# Set these in Vercel (Project -> Settings -> Environment Variables). Never commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The order bot made with @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Bearer token the Zeami agent uses for /api/agent/* and /api/orders
AGENT_TOKEN=
# Password for the pages Simenesh opens (the user name can be anything)
UI_PASSWORD=
