# Fake ChipChip ERP (payment requests). Set these in Vercel next to the variables of .env.example. Never commit real values.
# These are the MOCK's own tokens: make up long random strings. Never put the real ERP's API token here.

# Either a JSON list of tokens, one per calling system. system_name becomes external_source on every request it creates;
# auto_approve true answers status "approved", false answers "pending". revoked / expires_at (optional) test the 401s.
ERP_MOCK_TOKENS=[{"token":"<long-random-string-1>","system_name":"zeami-test","auto_approve":true},{"token":"<long-random-string-2>","system_name":"zeami-test-pending","auto_approve":false}]

# Or, when ERP_MOCK_TOKENS is not set, one token:
# ERP_MOCK_TOKEN=<long-random-string>
# ERP_MOCK_SOURCE=zeami-test
# ERP_MOCK_AUTO_APPROVE=true
